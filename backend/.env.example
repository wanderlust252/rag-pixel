APP_NAME=RAG Pixels Backend
APP_ENV=local

DOCUMENTS_DIR=app/storage/documents
INDEX_DIR=app/storage/index

# Required for write operations such as document upload and full document clear.
# Generate a strong random value and pass the same value to trusted MCP clients
# as RAG_PIXELS_API_KEY.
RAG_PIXELS_API_KEY=

RAG_LLM_PROVIDER=opencode_go
RAG_EMBEDDING_PROVIDER=huggingface
RAG_DOMAIN_PROFILE=logistics

# Document parsing. Keep markitdown for fully local conversion, or enable
# LlamaParse with MarkItDown fallback when LLAMA_CLOUD_API_KEY is configured.
RAG_PARSE_PROVIDER=markitdown
LLAMA_CLOUD_API_KEY=
LLAMAPARSE_TIER=cost_effective
LLAMAPARSE_VERSION=latest
LLAMAPARSE_TIMEOUT_SECONDS=120

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
HUGGINGFACE_EMBEDDING_MODEL=intfloat/multilingual-e5-small

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# OpenCode Go (OpenAI-compatible LLM endpoint)
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=kimi-k2.6
